
# Nexus environment variables

# Docker image tag (e.g. 3.94.1, latest)
image_tag={{ nexus_image_tag }}

# Domain name used in Traefik Host() routing rules
nexus_main_domain={{ nexus_main_domain }}

# Container restart policy (on-failure, always, unless-stopped)
restart_policy={{ restart_policy }}

# Nexus admin password
nexus_admin_pass={{ nexus_password }}