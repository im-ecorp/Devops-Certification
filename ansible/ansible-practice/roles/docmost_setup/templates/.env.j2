# Docmost environment variables

# Docker image tags
image_tag={{ docmost_image_tag }}
postgres_image_tag={{ docmost_postgres_image_tag }}
redis_image_tag={{ docmost_redis_image_tag }}

# Container restart policy (on-failure, always, unless-stopped)
restart_policy={{ restart_policy }}

# Docmost domain (used by Traefik Host() routing rules)
docmost_main_domain={{ docmost_main_domain }}

# Database connection strings
DATABASE_URL=postgresql://docmost:{{ docmost_db_password }}@db:5432/docmost
REDIS_URL=redis://redis:6379

# PostgreSQL password (used by the db service)
docmost_db_password={{ docmost_db_password }}

# Application settings
APP_URL={{ docmost_main_url }}
APP_SECRET='{{ docmost_app_secret }}'
JWT_TOKEN_EXPIRES_IN={{ docmost_jwt_token_expires_in }}
STORAGE_DRIVER={{ docmost_storage_driver }}
FILE_UPLOAD_SIZE_LIMIT={{ docmost_file_upload_size_limit }}
DISABLE_TELEMETRY={{ docmost_disable_telemetry | lower }}

{% if docmost_s3_username is defined and docmost_s3_username %}
# S3/MinIO storage
AWS_S3_ACCESS_KEY_ID='{{ docmost_s3_username }}'
AWS_S3_SECRET_ACCESS_KEY='{{ docmost_s3_password }}'
AWS_S3_REGION={{ docmost_s3_region }}
AWS_S3_BUCKET={{ docmost_s3_bucket }}
AWS_S3_ENDPOINT={{ docmost_s3_endpoint }}
AWS_S3_FORCE_PATH_STYLE=true
{% endif %}

{% if docmost_smtp_username is defined and docmost_smtp_username %}
# Mail (SMTP)
MAIL_DRIVER={{ docmost_mail_driver }}
MAIL_FROM_ADDRESS={{ docmost_mail_from_address }}
MAIL_FROM_NAME={{ docmost_mail_from_name }}
SMTP_HOST={{ docmost_smtp_host }}
SMTP_PORT={{ docmost_smtp_port }}
SMTP_USERNAME='{{ docmost_smtp_username }}'
SMTP_PASSWORD='{{ docmost_smtp_password }}'
SMTP_SECURE={{ docmost_smtp_secure | lower }}
SMTP_IGNORETLS={{ docmost_smtp_ignore_tls | lower }}
{% endif %}
