# MinIO environment variables template

# MinIO image tag
image_tag={{ minio_image_tag }}

# Container restart policy (always, unless-stopped, on-failure)
restart_policy={{ restart_policy }}

# MinIO root credentials (from Ansible Vault)
minio_root_user='{{ minio_root_user }}'
minio_root_password='{{ minio_root_password }}'

# MinIO domains (used by reverse proxy)
minio_api_domain={{ minio_api_domain }}
minio_console_domain={{ minio_console_domain }}
