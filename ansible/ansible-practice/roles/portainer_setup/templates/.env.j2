
# Portainer environment variables

# Docker image tag (e.g. 2.39.5)
image_tag={{ portainer_image_tag }}

# Portainer image name; Business Edition is used when a license key is set,
# otherwise Community Edition
portainer_image_name={{ 'portainer/portainer-ee' if portainer_license_key else 'portainer/portainer-ce' }}

# Domain names used in Traefik Host() routing rules
portainer_main_domain={{ portainer_main_domain }}
portainer_edge_domain={{ portainer_edge_domain }}

# Container restart policy (on-failure, always, unless-stopped)
restart_policy={{ restart_policy }}

# Portainer admin account credentials
portainer_admin_user='{{ portainer_admin_user }}'
portainer_admin_password='{{ portainer_admin_password }}'

# Optional Business Edition license key (leave empty for Community Edition)
portainer_license_key='{{ portainer_license_key }}'