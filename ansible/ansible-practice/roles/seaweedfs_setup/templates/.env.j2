# SeaweedFS environment variables

# Docker image tag
image_tag={{ seaweedfs_image_tag }}

# Container restart policy (always, unless-stopped, on-failure)
restart_policy={{ restart_policy }}

# Domains (used by Traefik Host() routing rules)
seaweedfs_s3_domain={{ seaweedfs_s3_domain }}
seaweedfs_admin_domain={{ seaweedfs_admin_domain }}
seaweedfs_master_domain={{ seaweedfs_master_domain | default('disabled') }}
seaweedfs_volume_domain={{ seaweedfs_volume_domain | default('disabled') }}
seaweedfs_filer_domain={{ seaweedfs_filer_domain | default('disabled') }}
seaweedfs_webdav_domain={{ seaweedfs_webdav_domain | default('disabled') }}

# Admin dashboard credentials (from Ansible Vault)
seaweedfs_admin_user='{{ seaweedfs_admin_user }}'
seaweedfs_admin_password='{{ seaweedfs_admin_password }}'
