# RustFS environment variables

# Docker image tag
image_tag={{ rustfs_image_tag }}

# Container restart policy (always, unless-stopped, on-failure)
restart_policy={{ restart_policy }}

# Root credentials
rustfs_root_user={{ rustfs_root_user }}
rustfs_root_password={{ rustfs_root_password }}

# Domains (used by Traefik Host() routing rules)
rustfs_api_domain={{ rustfs_api_domain }}
rustfs_console_domain={{ rustfs_console_domain }}
