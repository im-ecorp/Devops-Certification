# Ansible managed by nginx_setup
# {{ ansible_managed }}
{% if item.ssl_enabled | default(false) %}
server {
    listen {{ item.listen_port | default(80) }};
    server_name {{ item.server_name }};
    return 301 https://$host{% if item.ssl_port | default(443) | int != 443 %}:{{ item.ssl_port }}{% endif %}$request_uri;
}
{% endif %}

server {
{% if item.ssl_enabled | default(false) %}
    listen {{ item.ssl_port | default(443) }} ssl;
    ssl_certificate {{ item.ssl_cert_path }};
    ssl_certificate_key {{ item.ssl_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
{% else %}
    listen {{ item.listen_port | default(80) }};
{% endif %}
    server_name {{ item.server_name }};
    client_max_body_size {{ item.client_max_body_size | default(nginx_client_max_body_size) }};
{% if item.root | default('') %}
    root {{ item.root }};
    index index.html index.htm;
{% endif %}

    location / {
{% if item.proxy_pass | default('') %}
        proxy_pass {{ item.proxy_pass }};
        proxy_http_version 1.1;
        include {{ nginx_proxy_params_path }};
        proxy_read_timeout {{ item.proxy_read_timeout | default(nginx_proxy_read_timeout) }};
{% if item.proxy_pass.startswith('https://') %}
        proxy_ssl_server_name on;
{% endif %}
{% else %}
        try_files $uri $uri/ =404;
{% endif %}
    }
}
