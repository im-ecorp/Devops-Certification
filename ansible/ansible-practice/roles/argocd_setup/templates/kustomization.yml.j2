# {{ ansible_managed }}
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: {{ argocd_namespace }}
resources:
  - install-{{ argocd_resolved_version }}.yml
{% if argocd_traefik_enabled %}
patches:
  - target:
      kind: Service
      name: argocd-server
    patch: |-
      apiVersion: v1
      kind: Service
      metadata:
        name: argocd-server
      spec:
        type: NodePort
        ports:
          - $patch: replace
          - name: https
            port: 443
            targetPort: 8080
            protocol: TCP
            nodePort: {{ argocd_node_port }}
  - target:
      kind: ConfigMap
      name: argocd-cm
    patch: |-
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: argocd-cm
      data:
        url: "https://{{ argocd_domain }}"
{% endif %}
