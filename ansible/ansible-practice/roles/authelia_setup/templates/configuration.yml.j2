theme: light
default_2fa_method: totp

server:
  host: 0.0.0.0
  port: 9091

log:
  level: info

totp:
  issuer: authelia.com

authentication_backend:
  file:
    path: /config/users_database.yml

access_control:
  default_policy: deny
  rules:
    - domain: "{{ authelia_main_domain }}"
      policy: bypass
{% if authelia_openclaw_enabled %}
    - domain: "{{ authelia_openclaw_domain }}"
      policy: one_factor
{% endif %}
    - domain: "*.{{ main_domain }}"
      policy: bypass

session:
  name: authelia_session
  domain: "{{ main_domain }}"
  redis:
    host: authelia-redis
    port: 6379

storage:
  postgres:
    host: authelia-db
    port: 5432
    database: authelia
    username: authelia
    password: "{{ authelia_db_password | default('set_in_vault') }}"

notifier:
  filesystem:
    filename: /config/notification.txt
