TZ={{ authelia_timezone }}

# Versions
authelia_image_tag={{ authelia_image_tag }}
postgres_image_tag={{ authelia_postgres_image_tag }}
redis_image_tag={{ authelia_redis_image_tag }}

# Traefik domains
authelia_main_domain={{ authelia_main_domain }}
service_dir={{ service_dir }}
restart_policy={{ restart_policy }}

# Authelia Secrets
AUTHELIA_JWT_SECRET={{ authelia_jwt_secret | default('set_in_vault') }}
AUTHELIA_SESSION_SECRET={{ authelia_session_secret | default('set_in_vault') }}
AUTHELIA_STORAGE_ENCRYPTION_KEY={{ authelia_storage_encryption_key | default('set_in_vault') }}
authelia_db_password={{ authelia_db_password | default('set_in_vault') }}
