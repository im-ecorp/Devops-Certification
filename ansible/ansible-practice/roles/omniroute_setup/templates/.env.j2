# OmniRoute environment variables

# Docker image tags
image_tag={{ omniroute_image_tag }}
redis_image_tag={{ omniroute_redis_image_tag }}

# Container restart policy (always, unless-stopped, on-failure)
restart_policy={{ restart_policy }}

# OmniRoute domain (used by Traefik Host() routing rules)
omniroute_main_domain={{ omniroute_main_domain }}

# Application URLs
omniroute_base_url=https://{{ omniroute_main_domain }}
omniroute_cloud_url={{ omniroute_cloud_url }}

# Ports and security toggles
omniroute_port={{ omniroute_port }}
omniroute_local_port={{ omniroute_local_port }}
omniroute_require_api_key={{ omniroute_require_api_key }}
omniroute_auth_cookie_secure={{ omniroute_auth_cookie_secure }}

# Resource limits
omniroute_memory_mb={{ omniroute_memory_mb }}
omniroute_memory_limit={{ omniroute_memory_limit }}
omniroute_cpu_limit={{ omniroute_cpu_limit }}
omniroute_pids_limit={{ omniroute_pids_limit }}
omniroute_redis_maxmemory={{ omniroute_redis_maxmemory }}
omniroute_redis_memory_limit={{ omniroute_redis_memory_limit }}
omniroute_redis_cpu_limit={{ omniroute_redis_cpu_limit }}

# JWT signing key for dashboard session tokens
JWT_SECRET='{{ omniroute_jwt_secret }}'

# Encryption key for API keys stored in the database
API_KEY_SECRET='{{ omniroute_api_key_secret }}'

# Initial admin login password
INITIAL_PASSWORD='{{ omniroute_initial_password }}'

# SQLite storage encryption. Never change or drop it once set: the existing
# database becomes unreadable without the original key
STORAGE_ENCRYPTION_KEY='{{ omniroute_storage_encryption_key | default('') }}'
