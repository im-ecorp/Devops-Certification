# OmniRoute environment variables

image_tag={{ omniroute_image_tag }}

redis_image_tag={{ omniroute_redis_image_tag }}

nginx_image_tag={{ nginx_image_tag }}

restart_policy={{ restart_policy }}

omniroute_main_domain={{ omniroute_main_domain }}

omniroute_base_url=https://{{ omniroute_main_domain }}
omniroute_cloud_url={{ omniroute_cloud_url }}

# JWT signing key for dashboard session tokens
JWT_SECRET={{ omniroute_jwt_secret }}

# Encryption key for API keys stored in the database
API_KEY_SECRET={{ omniroute_api_key_secret }}

# Initial admin login password
INITIAL_PASSWORD={{ omniroute_initial_password }}

# Storage encryption
STORAGE_ENCRYPTION_KEY={{ omniroute_storage_encryption_key | default('') }}
