services:

  # Hermes WebUI — browser front end for the Hermes Agent
  hermes-webui:
    image: ghcr.io/nesquena/hermes-webui:${image_tag}
    container_name: hermes-webui
    hostname: hermes-webui
    restart: ${restart_policy}
    init: true
    # Wraps the upstream entrypoint so a root-owned Hermes home keeps its owner
    entrypoint: ["/bin/bash", "/opt/hermes-webui/root-entrypoint.sh"]
    environment:
      PATH: ${hermes_webui_container_path}
      UV_PYTHON: ${hermes_webui_python_version}
      WANTED_UID: ${hermes_webui_uid}
      WANTED_GID: ${hermes_webui_gid}
      HERMES_WEBUI_ROOT_HOME_MODE: ${hermes_webui_root_home_mode}
      HERMES_HOME: /home/hermeswebui/.hermes
      HERMES_CONFIG_PATH: /home/hermeswebui/.hermes/config.yaml
      HERMES_WEBUI_AGENT_DIR: /opt/hermes
      HERMES_WEBUI_STATE_DIR: /var/lib/hermes-webui
      HERMES_WEBUI_HOST: 0.0.0.0
      HERMES_WEBUI_PORT: ${hermes_webui_port}
      HERMES_WEBUI_PASSWORD: ${hermes_webui_password}
      HERMES_WEBUI_SECURE: ${hermes_webui_secure}
      HERMES_WEBUI_ALLOWED_ORIGINS: ${hermes_webui_url}
      HERMES_WEBUI_TRUST_FORWARDED_HOST: ${hermes_webui_trust_forwarded}
      HERMES_WEBUI_TRUST_FORWARDED_FOR: ${hermes_webui_trust_forwarded}
      HERMES_WEBUI_TRUST_FORWARDED_PROTO: ${hermes_webui_trust_forwarded}
      HERMES_WEBUI_SKIP_ONBOARDING: ${hermes_webui_skip_onboarding}
      HERMES_SKIP_CHMOD: ${hermes_webui_skip_chmod}
{% if hermes_webui_host_fs_enabled | bool %}
      # Prefix of the whole host filesystem (the host's /etc is /host/etc)
      HERMES_HOST_FS: ${hermes_webui_host_fs_mount_point}
{% endif %}
{% if hermes_webui_host_executor_enabled | bool %}
      # How the agent runs commands on the host; see the role README
      HERMES_HOST_EXECUTOR: ${hermes_webui_host_executor}
      HERMES_HOST_EXECUTOR_SSH: ${hermes_webui_host_executor_ssh}
      HERMES_HOST_EXECUTOR_ENV: ${hermes_webui_host_executor_env}
    extra_hosts:
      - "${hermes_webui_host_alias}:host-gateway"
{% endif %}
    volumes:
      # Existing Hermes CLI home: config.yaml, auth.json and state.db
      - ${hermes_webui_home_dir}:/home/hermeswebui/.hermes
      # Copy of the installed Agent source
      - ./agent-source:/opt/hermes:ro
      # WebUI sessions and settings
      - ./state:/var/lib/hermes-webui
      - ./root-entrypoint.sh:/opt/hermes-webui/root-entrypoint.sh:ro
      # Workspaces, mounted at their host paths
{% for workspace in hermes_webui_workspaces %}
      - {{ workspace.path }}:{{ workspace.path }}:{{ 'ro' if workspace.read_only | default(false) | bool else 'rw' }}
{% endfor %}
{% if hermes_webui_host_fs_enabled | bool %}
      # Whole host filesystem, without shadowing the container's own OS
      - /:${hermes_webui_host_fs_mount_point}:${hermes_webui_host_fs_mode}
{% endif %}
{% if hermes_webui_ssh_enabled | bool %}
      # Host SSH keys as the agent's ~/.ssh
      - ${hermes_webui_ssh_dir}:${hermes_webui_container_home}/.ssh:ro
{% endif %}
    security_opt:
      - no-new-privileges:true
    mem_limit: ${hermes_webui_memory_limit}
    cpus: ${hermes_webui_cpu_limit}
    stop_grace_period: 30s
    logging:
      driver: json-file
      options:
        max-size: ${hermes_webui_log_max_size}
        max-file: ${hermes_webui_log_max_file}
    networks:
      - web_net
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:${hermes_webui_port}/health')"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=web_net"
      - "traefik.http.routers.http-hermes-webui.rule=Host(`${hermes_webui_domain}`)"
      - "traefik.http.routers.http-hermes-webui.entrypoints=web"
      - "traefik.http.routers.hermes-webui.rule=Host(`${hermes_webui_domain}`)"
      - "traefik.http.routers.hermes-webui.entrypoints=web-secure"
      - "traefik.http.routers.hermes-webui.tls=true"
      - "traefik.http.routers.hermes-webui.tls.certresolver=myproduction"
      - "traefik.http.routers.hermes-webui.service=hermes-webui"
      - "traefik.http.services.hermes-webui.loadBalancer.server.port=${hermes_webui_port}"

networks:
  web_net:
    name: web_net
    external: true
  app_net:
    name: app_net
    external: true
