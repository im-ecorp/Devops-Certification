# {{ ansible_managed }}
#
# Rendered with no_log; mode 0600. Contains the WebUI login password.

# Official published image, by tag or by digest pin
hermes_webui_image={{ hermes_webui_effective_image | trim }}

# Container restart policy
restart_policy={{ restart_policy }}

# PATH inside the container, including the app venv that provides `hermes`
hermes_webui_container_path={{ hermes_webui_container_path | trim }}

# Hermes WebUI port (internal, served to Traefik)
hermes_webui_port={{ hermes_webui_port }}

# Hermes WebUI public domain (used by Traefik labels)
hermes_webui_domain={{ hermes_webui_domain }}

# Host UID/GID mapping for bind-mounted data directories
wanted_uid={{ hermes_webui_uid }}
wanted_gid={{ hermes_webui_gid }}

# Resource ceilings
hermes_webui_memory_limit={{ hermes_webui_memory_limit }}
hermes_webui_cpu_limit={{ hermes_webui_cpu_limit }}

# Log rotation
hermes_webui_log_max_size={{ hermes_webui_log_max_size }}
hermes_webui_log_max_file={{ hermes_webui_log_max_file }}

# Remote access password (served publicly through Traefik)
hermes_webui_password={{ hermes_webui_password }}

# HTTPS / reverse-proxy settings (behind Traefik)
hermes_webui_secure={{ hermes_webui_secure }}
hermes_webui_allowed_origins={{ hermes_webui_allowed_origins }}
hermes_webui_trust_forwarded_host={{ hermes_webui_trust_forwarded_host }}
hermes_webui_trust_forwarded_for={{ hermes_webui_trust_forwarded_for }}
hermes_webui_trust_forwarded_proto={{ hermes_webui_trust_forwarded_proto }}

# Existing-home safety controls
hermes_webui_skip_onboarding={{ hermes_webui_skip_onboarding }}
hermes_webui_skip_chmod={{ hermes_webui_skip_chmod }}
