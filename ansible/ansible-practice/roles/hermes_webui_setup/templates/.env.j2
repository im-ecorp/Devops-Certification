# Hermes WebUI environment variables
{% set hermes_webui_root_home = hermes_webui_home_stat.stat.uid == 0 %}

# Docker image tag
image_tag={{ hermes_webui_image_tag }}

# Container restart policy (always, on-failure, unless-stopped)
restart_policy={{ restart_policy }}

# Hermes WebUI domain (used by Traefik Host() routing rules)
hermes_webui_domain={{ hermes_webui_domain }}
hermes_webui_url={{ hermes_webui_url }}

# Port the app listens on inside the container
hermes_webui_port={{ hermes_webui_port }}

# Login password (the service is public)
hermes_webui_password='{{ hermes_webui_password }}'

# HTTPS and reverse-proxy settings
hermes_webui_secure={{ hermes_webui_secure }}
hermes_webui_trust_forwarded={{ hermes_webui_trust_forwarded }}

# Use the existing Hermes config without onboarding or chmod
hermes_webui_skip_onboarding={{ hermes_webui_skip_onboarding }}
hermes_webui_skip_chmod={{ hermes_webui_skip_chmod }}

# Hermes home and its owner; a root-owned home runs the container as root
hermes_webui_home_dir={{ hermes_webui_home_dir }}
hermes_webui_uid={{ hermes_webui_home_stat.stat.uid }}
hermes_webui_gid={{ hermes_webui_home_stat.stat.gid }}
hermes_webui_root_home_mode={{ 1 if hermes_webui_root_home else 0 }}
hermes_webui_container_home={{ '/root' if hermes_webui_root_home else '/home/hermeswebui' }}

# Python for the WebUI venv (must satisfy the Agent's dependency markers)
hermes_webui_python_version={{ hermes_webui_python_version }}

# PATH inside the container, including the bundled `hermes` CLI
hermes_webui_container_path={{ hermes_webui_container_path }}
{% if hermes_webui_host_fs_enabled | bool %}

# Whole host filesystem mount
hermes_webui_host_fs_mount_point={{ hermes_webui_host_fs_mount_point }}
hermes_webui_host_fs_mode={{ 'ro' if hermes_webui_host_fs_read_only | bool else 'rw' }}
{% endif %}
{% if hermes_webui_ssh_enabled | bool %}

# Host SSH directory, mounted read-only
hermes_webui_ssh_dir={{ hermes_webui_ssh_dir }}
{% endif %}
{% if hermes_webui_host_executor_enabled | bool %}

# Host executor. A non-interactive SSH session has no locale and Ansible needs
# UTF-8. ~/.ssh is read-only, so host keys are not recorded.
hermes_webui_host_alias={{ hermes_webui_host_alias }}
hermes_webui_host_executor={{ hermes_webui_host_alias }}:{{ hermes_webui_host_ssh_port }}
hermes_webui_host_executor_ssh='ssh -p {{ hermes_webui_host_ssh_port }} -i ~/.ssh/{{ hermes_webui_ssh_key_name }} -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR root@{{ hermes_webui_host_alias }}'
hermes_webui_host_executor_env='LC_ALL=C.UTF-8 LANG=C.UTF-8'
{% endif %}

# Container limits and log rotation
hermes_webui_memory_limit={{ hermes_webui_memory_limit }}
hermes_webui_cpu_limit={{ hermes_webui_cpu_limit }}
hermes_webui_log_max_size={{ hermes_webui_log_max_size }}
hermes_webui_log_max_file={{ hermes_webui_log_max_file }}
