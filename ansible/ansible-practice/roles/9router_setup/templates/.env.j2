# 9router environment variables

# Docker image tags
image_tag={{ nine_router_image_tag }}
headroom_image_tag={{ nine_router_headroom_image_tag }}

# Container restart policy (always, unless-stopped, on-failure)
restart_policy={{ restart_policy }}

# 9router domain (used by Traefik Host() routing rules)
nine_router_main_domain={{ nine_router_main_domain }}

# Headroom domain (used by Traefik Host() routing rules)
headroom_main_domain={{ headroom_main_domain }}

# Application settings
JWT_SECRET={{ nine_router_jwt_secret }}

BASE_URL={{ nine_router_main_url }}
CLOUD_URL={{ nine_router_main_url }}
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL={{ nine_router_main_url }}
NEXT_PUBLIC_CLOUD_URL={{ nine_router_main_url }}


# Headroom BasicAuth credentials (htpasswd hashed)
headroom_auth_user='{{ headroom_web_auth_user }}'
headroom_auth_pass='{{ headroom_web_auth_pass }}'

# Initial password for remote access
INITIAL_PASSWORD={{ nine_router_initial_password }}
