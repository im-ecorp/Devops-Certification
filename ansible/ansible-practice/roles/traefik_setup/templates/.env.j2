# Traefik environment variables

# Docker image tag (e.g. v3.0, latest)
image_tag={{ traefik_image_tag }}

# Domain name used in Traefik Host() routing rules
traefik_domain={{ traefik_domain }}

# Container restart policy (on-failure, always, unless-stopped)
restart_policy={{ restart_policy }}

# Email address for Let's Encrypt ACME certificate notifications
acme_email={{ acme_email }}

# Web dashboard authentication credentials (htpasswd hashed)
web_auth_user='{{ traefik_web_auth_user }}'
web_auth_pass='{{ traefik_web_auth_pass }}'
