# Mailserver environment variables

# Docker image tags
image_tag={{ mailserver_image_tag }}
whoami_image_tag={{ mailserver_whoami_image_tag }}

# Container restart policy (on-failure, always, unless-stopped)
restart_policy={{ restart_policy }}

# Service directory (the config/ folder is mounted from here)
service_dir={{ service_dir }}

# Mail server FQDN (MX target, TLS certificate and Traefik Host() rule)
mailserver_hostname={{ mailserver_hostname }}

# Container memory limit
mailserver_memory_limit={{ mailserver_memory_limit }}

# Traefik acme.json on the host (mounted read-only)
acme_json_path={{ mailserver_traefik_volume_info.volume.Mountpoint }}/acme.json

# General
TZ={{ mailserver_timezone }}
POSTMASTER_ADDRESS={{ mailserver_postmaster_address }}
POSTFIX_MESSAGE_SIZE_LIMIT={{ mailserver_message_size_limit }}

# Users may send only from their own address or aliases
SPOOF_PROTECTION=1

# TLS certificate from Traefik's acme.json
SSL_TYPE=letsencrypt

{% if mailserver_webmail_enabled | bool %}
# Roundcube webmail
webmail_image_tag={{ mailserver_webmail_image_tag }}
webmail_memory_limit={{ mailserver_webmail_memory_limit }}
mailserver_webmail_subnet={{ mailserver_webmail_subnet }}
mailserver_webmail_ip={{ mailserver_webmail_ip }}
ROUNDCUBEMAIL_DEFAULT_HOST=ssl://{{ mailserver_hostname }}
ROUNDCUBEMAIL_DEFAULT_PORT=993
ROUNDCUBEMAIL_SMTP_SERVER=ssl://{{ mailserver_hostname }}
ROUNDCUBEMAIL_SMTP_PORT=465
# Users can sign in with just their name; the domain is added
ROUNDCUBEMAIL_USERNAME_DOMAIN={{ mailserver_domain }}
# Attachments grow by a third when encoded, so allow 3/4 of the message size limit
ROUNDCUBEMAIL_UPLOAD_MAX_FILESIZE={{ mailserver_message_size_limit | int * 3 // 4 // 1048576 }}M
ROUNDCUBEMAIL_DES_KEY='{{ mailserver_webmail_des_key }}'

{% endif %}
# Rspamd handles spam, DKIM, DMARC and SPF, so the older services it replaces are off
ENABLE_RSPAMD=1
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0

# Ban IPs after repeated failed logins
ENABLE_FAIL2BAN=1
