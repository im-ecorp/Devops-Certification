# Vaultwarden environment variables

# Docker image tags
image_tag={{ vaultwarden_image_tag }}

# Container restart policy (on-failure, always, unless-stopped)
restart_policy={{ restart_policy }}

# Vaultwarden domain (used by Traefik Host() routing rules)
vaultwarden_main_domain={{ vaultwarden_main_domain }}

# Base configuration
DOMAIN={{ vaultwarden_main_url }}
ROCKET_PORT={{ vaultwarden_port }}
SIGNUPS_ALLOWED={{ vaultwarden_signups_allowed | lower }}
INVITATIONS_ALLOWED={{ vaultwarden_invitations_allowed | lower }}
SHOW_PASSWORD_HINT={{ vaultwarden_show_password_hint | lower }}
PASSWORD_HINTS_ALLOWED={{ vaultwarden_password_hints_allowed | lower }}
ENABLE_WEBSOCKET={{ vaultwarden_websocket_enabled | lower }}
LOGIN_RATELIMIT_SECONDS={{ vaultwarden_login_ratelimit_seconds }}
LOGIN_RATELIMIT_MAX_BURST={{ vaultwarden_login_ratelimit_max_burst }}
{% if vaultwarden_admin_token_enabled %}
ADMIN_SESSION_LIFETIME={{ vaultwarden_admin_session_lifetime }}
ADMIN_RATELIMIT_SECONDS={{ vaultwarden_admin_ratelimit_seconds }}
ADMIN_RATELIMIT_MAX_BURST={{ vaultwarden_admin_ratelimit_max_burst }}
{% endif %}

{% if vaultwarden_admin_token_enabled and vaultwarden_admin_token %}
# Admin page token (single-quoted to prevent compose shell interpolation)
ADMIN_TOKEN='{{ vaultwarden_admin_token }}'
{% endif %}

{% if vaultwarden_smtp_enabled %}
# Mail (SMTP)
SMTP_HOST={{ vaultwarden_smtp_host }}
SMTP_PORT={{ vaultwarden_smtp_port }}
SMTP_FROM={{ vaultwarden_smtp_from }}
SMTP_FROM_NAME={{ vaultwarden_smtp_from_name }}
SMTP_SECURITY={{ vaultwarden_smtp_security }}
{% if vaultwarden_smtp_username %}
SMTP_USERNAME='{{ vaultwarden_smtp_username }}'
SMTP_PASSWORD='{{ vaultwarden_smtp_password }}'
{% endif %}
{% endif %}
