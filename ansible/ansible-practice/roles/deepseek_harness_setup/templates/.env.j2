# DeepSeek Harness environment variables

# Docker image tag of the official node image
image_tag={{ deepseek_image_tag }}

# Package version of @deepseek-ai/dsh
deepseek_dsh_version={{ deepseek_dsh_version }}

# Container restart policy (always, on-failure, unless-stopped)
restart_policy={{ restart_policy }}

# DeepSeek Harness domain (used by Traefik Host() routing rules)
deepseek_domain={{ deepseek_domain }}

# Port served to Traefik
deepseek_port={{ deepseek_port }}
