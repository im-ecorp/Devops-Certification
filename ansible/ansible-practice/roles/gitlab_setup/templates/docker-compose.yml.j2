services:

  # GitLab CE — Git hosting, CI and container registry (Omnibus image)
  gitlab:
    image: gitlab/gitlab-ce:${image_tag}
    container_name: gitlab
    hostname: ${gitlab_domain}
    restart: ${restart_policy}
    shm_size: ${gitlab_shm_size}
    mem_limit: ${gitlab_memory_limit}
    ports:
      # Git over SSH; HTTP(S) goes through Traefik
      - "${gitlab_ssh_port}:22"
    volumes:
      - gitlab_data:/var/opt/gitlab
      - gitlab_log:/var/log/gitlab
      - gitlab_backup:/var/opt/gitlab/backups
      - gitlab_config:/etc/gitlab
    networks:
      - web_net
      - app_net
    environment:
      GITLAB_ROOT_PASSWORD: ${GITLAB_ROOT_PASSWORD}
{% if gitlab_smtp_enable | bool %}
      GITLAB_SMTP_PASSWORD: ${GITLAB_SMTP_PASSWORD}
{% endif %}
{% if gitlab_backup_s3_enabled | bool %}
      GITLAB_BACKUP_S3_ACCESS_KEY: ${GITLAB_BACKUP_S3_ACCESS_KEY}
      GITLAB_BACKUP_S3_SECRET_KEY: ${GITLAB_BACKUP_S3_SECRET_KEY}
{% endif %}
      GITLAB_OMNIBUS_CONFIG: |
        # ---------------------
        # General
        # ---------------------
        external_url 'https://${gitlab_domain}'
        gitlab_rails['gitlab_shell_ssh_port'] = ${gitlab_ssh_port}

        # ---------------------
        # Root password (applied on first start only)
        # ---------------------
        gitlab_rails['initial_root_password'] = ENV['GITLAB_ROOT_PASSWORD']
        gitlab_rails['display_initial_root_password'] = false
        gitlab_rails['store_initial_root_password'] = false

        # ---------------------
        # Nginx (TLS terminates at Traefik)
        # ---------------------
        nginx['enable'] = true
        nginx['client_max_body_size'] = '${gitlab_client_max_body_size}'
        nginx['redirect_http_to_https'] = false
        nginx['gzip_enabled'] = true
        nginx['listen_port'] = 80
        nginx['listen_https'] = false
        nginx['proxy_protocol'] = false
{% if gitlab_smtp_enable | bool %}

        # ---------------------
        # SMTP (outgoing email, implicit TLS on 465)
        # ---------------------
        gitlab_rails['smtp_enable'] = true
        gitlab_rails['smtp_address'] = '${gitlab_smtp_address}'
        gitlab_rails['smtp_port'] = ${gitlab_smtp_port}
        gitlab_rails['smtp_user_name'] = '${gitlab_smtp_username}'
        gitlab_rails['smtp_password'] = ENV['GITLAB_SMTP_PASSWORD']
        gitlab_rails['smtp_domain'] = '${gitlab_smtp_domain}'
        gitlab_rails['smtp_authentication'] = 'login'
        gitlab_rails['smtp_enable_starttls_auto'] = false
        gitlab_rails['smtp_tls'] = true
        gitlab_rails['smtp_openssl_verify_mode'] = 'peer'
        gitlab_rails['gitlab_email_from'] = '${gitlab_email_from}'
        gitlab_rails['gitlab_email_reply_to'] = '${gitlab_email_from}'
        gitlab_rails['gitlab_email_display_name'] = '${gitlab_email_display_name}'
{% endif %}

        # ---------------------
        # Rate limiting (RackAttack)
        # ---------------------
        gitlab_rails['rack_attack_git_basic_auth'] = {
          'enabled' => true,
          'ip_whitelist' => {{ gitlab_ip_whitelist | to_json }},
          'maxretry' => 10,
          'findtime' => 60,
          'bantime' => 3600
        }

        # ---------------------
        # Backup — local
        # ---------------------
        gitlab_rails['manage_backup_path'] = true
        gitlab_rails['backup_path'] = "/var/opt/gitlab/backups"
        gitlab_rails['backup_archive_permissions'] = 0644
        gitlab_rails['backup_keep_time'] = ${gitlab_backup_keep_time}
{% if gitlab_backup_s3_enabled | bool %}

        # Backup — copy to S3-compatible storage
        gitlab_rails['backup_upload_connection'] = {
          'provider' => 'AWS',
          'region' => '${gitlab_backup_s3_region}',
          'aws_access_key_id' => ENV['GITLAB_BACKUP_S3_ACCESS_KEY'],
          'aws_secret_access_key' => ENV['GITLAB_BACKUP_S3_SECRET_KEY'],
          'endpoint' => '${gitlab_backup_s3_endpoint}',
          'path_style' => true
        }
        gitlab_rails['backup_upload_remote_directory'] = '${gitlab_backup_s3_bucket}'
        gitlab_rails['backup_multipart_chunk_size'] = 104857600
{% endif %}

        # ---------------------
        # Environment for Rails and rake (backups read SKIP from here)
        # ---------------------
        gitlab_rails['env'] = {
{% if gitlab_low_memory | bool %}
          'MALLOC_CONF' => 'dirty_decay_ms:1000,muzzy_decay_ms:1000',
{% endif %}
          'SKIP' => '${gitlab_backup_skip}'
        }

        # ---------------------
        # Container registry
        # ---------------------
{% if gitlab_registry_enabled | bool %}
        registry_external_url 'https://${registry_domain}'
        registry_nginx['enable'] = true
        registry_nginx['listen_port'] = 5001
        registry_nginx['listen_https'] = false
        registry_nginx['proxy_set_headers'] = {
          "Host" => "$$http_host",
          "X-Real-IP" => "$$remote_addr",
          "X-Forwarded-For" => "$$proxy_add_x_forwarded_for",
          "X-Forwarded-Proto" => "https",
          "X-Forwarded-Ssl" => "on"
        }
{% else %}
        registry['enable'] = false
        gitlab_rails['registry_enabled'] = false
{% endif %}

        # ---------------------
        # Disable unused services
        # ---------------------
        letsencrypt['enable'] = false
        prometheus_monitoring['enable'] = false
        prometheus['enable'] = false
        alertmanager['enable'] = false
        node_exporter['enable'] = false
        redis_exporter['enable'] = false
        postgres_exporter['enable'] = false
        gitlab_exporter['enable'] = false
        puma['exporter_enabled'] = false
        sidekiq['metrics_enabled'] = false
        gitlab_rails['usage_ping_enabled'] = false
{% if gitlab_low_memory | bool %}

        # ---------------------
        # Low memory (GitLab's memory-constrained settings)
        # ---------------------
        gitlab_kas['enable'] = false
        puma['worker_processes'] = 0
        sidekiq['concurrency'] = 10
        gitaly['configuration'] = {
          concurrency: [
            {
              'rpc' => "/gitaly.SmartHTTPService/PostReceivePack",
              'max_per_repo' => 3,
            }, {
              'rpc' => "/gitaly.SSHService/SSHUploadPack",
              'max_per_repo' => 3,
            },
          ],
        }
        gitaly['env'] = {
          'MALLOC_CONF' => 'dirty_decay_ms:1000,muzzy_decay_ms:1000',
          'GITALY_COMMAND_SPAWN_MAX_PARALLEL' => '2'
        }
        # Sized for the container; GitLab would otherwise size these from the host's CPUs and RAM
        nginx['worker_processes'] = 2
        postgresql['shared_buffers'] = '256MB'
        postgresql['effective_cache_size'] = '1GB'
{% endif %}
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:80/-/health || exit 1"]
      interval: 60s
      timeout: 10s
      retries: 5
      start_period: 300s
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=web_net"
      - "traefik.http.routers.http-git.rule=Host(`${gitlab_domain}`)"
      - "traefik.http.routers.http-git.entrypoints=web"
      - "traefik.http.routers.http-git.service=git"
      - "traefik.http.routers.git.rule=Host(`${gitlab_domain}`)"
      - "traefik.http.routers.git.entrypoints=web-secure"
      - "traefik.http.routers.git.tls=true"
      - "traefik.http.routers.git.tls.certresolver=myproduction"
      - "traefik.http.routers.git.service=git"
      - "traefik.http.services.git.loadBalancer.server.port=80"
{% if gitlab_registry_enabled | bool %}
      - "traefik.http.routers.http-reg.rule=Host(`${registry_domain}`)"
      - "traefik.http.routers.http-reg.entrypoints=web"
      - "traefik.http.routers.http-reg.service=reg"
      - "traefik.http.routers.reg.rule=Host(`${registry_domain}`)"
      - "traefik.http.routers.reg.entrypoints=web-secure"
      - "traefik.http.routers.reg.tls=true"
      - "traefik.http.routers.reg.tls.certresolver=myproduction"
      - "traefik.http.routers.reg.service=reg"
      - "traefik.http.services.reg.loadBalancer.server.port=5001"
{% endif %}

networks:
  web_net:
    name: web_net
    external: true
  app_net:
    name: app_net
    external: true

volumes:
  gitlab_data:
    name: gitlab_data
  gitlab_log:
    name: gitlab_log
  gitlab_backup:
    name: gitlab_backups
  gitlab_config:
    name: gitlab_config
