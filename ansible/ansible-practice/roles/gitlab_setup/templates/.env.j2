
# GitLab environment variables template

# GitLab Docker image tag (e.g. 17.1.0, latest)
image_tag={{ gitlab_image_tag }}

# Container restart policy (on-failure, always, unless-stopped)
restart_policy={{ restart_policy }}

# GitLab external URL and domain
gitlab_domain={{ gitlab_main_domain }}
registry_domain ={{ gitlab_registry_domain }}

# GitLab root password
gitlab_root_password={{ gitlab_root_password }}

# gitlab gmail smtp config
smtp_enable={{ gitlab_smtp_enable }}
smtp_address={{ gitlab_smtp_address }}
smtp_domain= {{ gitlab_smtp_domain }}
smtp_port={{ gitlab_smtp_port }}
smtp_username={{ gitlab_smtp_username }}
smtp_password={{ gitlab_smtp_password }}

# Rate limiting — IPs that bypass RackAttack
gitlab_ip_whitelist= {{ gitlab_ip_whitelist }}

# Gitlab S3 config for send backup to minio
gitlab_s3_endpoint='{{ minio_api_endpoint }}'
gitlab_s3_username='{{ minio_gitlab_backup_username }}'
gitlab_s3_password='{{ minio_gitlab_backup_password }}'
gitlab_s3_bucket='{{ minio_gitlab_backup_bucket }}'