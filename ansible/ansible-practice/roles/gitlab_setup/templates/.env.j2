# GitLab environment variables

# Docker image tag (e.g. 19.4.1-ce.0)
image_tag={{ gitlab_image_tag }}

# Container restart policy (on-failure, always, unless-stopped)
restart_policy={{ restart_policy }}

# GitLab and registry domains (Traefik Host() rules and external URLs)
gitlab_domain={{ gitlab_main_domain }}
registry_domain={{ gitlab_registry_domain }}

# Git over SSH host port
gitlab_ssh_port={{ gitlab_ssh_port }}

# Container resources
gitlab_memory_limit={{ gitlab_memory_limit }}
gitlab_shm_size={{ gitlab_shm_size }}

# Nginx
gitlab_client_max_body_size={{ gitlab_client_max_body_size }}

# Backups
gitlab_backup_keep_time={{ gitlab_backup_keep_time }}
gitlab_backup_skip={{ gitlab_backup_skip }}

# Secrets are read by gitlab.rb through ENV, so no quoting inside Ruby is needed
GITLAB_ROOT_PASSWORD='{{ gitlab_root_password }}'

{% if gitlab_smtp_enable | bool %}
# Outgoing email (SMTPS with implicit TLS)
gitlab_smtp_address={{ gitlab_smtp_address }}
gitlab_smtp_port={{ gitlab_smtp_port }}
gitlab_smtp_domain={{ gitlab_smtp_domain }}
gitlab_smtp_username={{ gitlab_smtp_username }}
gitlab_email_from={{ gitlab_email_from }}
gitlab_email_display_name={{ gitlab_email_display_name }}
GITLAB_SMTP_PASSWORD='{{ gitlab_smtp_password }}'
{% endif %}

{% if gitlab_minio_enabled | bool %}
# Backup upload to MinIO
gitlab_minio_endpoint={{ gitlab_minio_endpoint }}
gitlab_minio_region={{ gitlab_minio_region }}
gitlab_minio_bucket={{ gitlab_minio_bucket }}
GITLAB_MINIO_ACCESS_KEY='{{ gitlab_minio_access_key }}'
GITLAB_MINIO_SECRET_KEY='{{ gitlab_minio_secret_key }}'
{% endif %}
