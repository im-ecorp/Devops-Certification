{
  "delete_repositories_opt_in": [
    "maven-snapshots",
    "maven-public",
    "maven-central",
    "maven-releases",
    "nuget-hosted",
    "nuget-group",
    "nuget.org-proxy"
  ],
  "blob_stores": [
    {
      "name": "apt",
      "path": "apt"
    },
    {
      "name": "docker",
      "path": "docker"
    },
    {
      "name": "raw",
      "path": "raw"
    }
  ],
  "cleanup_policies": [
    {
      "name": "apt",
      "format": "apt",
      "notes": "",
      "criteriaLastBlobUpdated": 30,
      "criteriaLastDownloaded": 90
    },
    {
      "name": "docker",
      "format": "docker",
      "notes": "",
      "criteriaLastBlobUpdated": 30,
      "criteriaLastDownloaded": 90
    },
    {
      "name": "raw",
