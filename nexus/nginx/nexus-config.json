      "notes": "",
      "criteriaLastBlobUpdated": 30,
      "criteriaLastDownloaded": 90
    },
    {
      "name": "pypi",
      "format": "pypi",
      "notes": "",
      "criteriaLastBlobUpdated": 30,
      "criteriaLastDownloaded": 90
    }
  ],
  "repositories": [
    {
      "format": "apt",
      "body": {
        "name": "ubuntu",
        "online": true,
        "storage": {
          "blobStoreName": "apt",
          "strictContentTypeValidation": true,
          "writePolicy": "ALLOW_ONCE"
        },
        "cleanup": {
          "policyNames": [
            "apt"
          ]
        },
        "proxy": {
          "remoteUrl": "http://archive.ubuntu.com/ubuntu/",
          "contentMaxAge": 1440,
          "metadataMaxAge": 1440,
          "assetMaxAge": 1440
        },
        "negativeCache": {
          "enabled": true,
          "timeToLive": 1440
        },
        "httpClient": {
          "blocked": false,
          "autoBlock": true
        },
        "apt": {
          "distribution": "focal,focal-updates,focal-backports,jammy,jammy-updates,jammy-backports,noble,noble-updates,noble-backports",
          "flat": false
        }
      }
    },
