# Standalone Nexus (Traefik) Environment Configuration
# Copy to .env and adjust variables before running docker compose

# Base Nexus image tag and container restart policy
NEXUS_IMAGE_TAG=3.94.1
RESTART_POLICY=always

# Initial administrative password (replaces Ansible vault variable nexus_admin_pass)
NEXUS_ADMIN_PASSWORD=

# Traefik routing configuration
TRAEFIK_CERTRESOLVER=myproduction

# Domains for Nexus UI and Docker repositories (derived from role defaults)
NEXUS_MAIN_DOMAIN=repo.w.k8sforfun.com
NEXUS_HUB_DOMAIN=hub.w.k8sforfun.com
NEXUS_QUAY_DOMAIN=quay.w.k8sforfun.com
NEXUS_K8S_DOMAIN=k8s.w.k8sforfun.com
NEXUS_GCR_DOMAIN=gcr.w.k8sforfun.com
NEXUS_K8S_GCR_DOMAIN=k8s-gcr.w.k8sforfun.com
NEXUS_GITHUB_DOMAIN=github.w.k8sforfun.com
